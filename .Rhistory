library(shiny)
library(shinybusy)
ui <- fluidPage(
add_busy_spinner(spin = "fading-circle"),
actionButton("go", "Start Process"),
verbatimTextOutput("result")
)
server <- function(input, output, session) {
observeEvent(input$go, {
Sys.sleep(3)  # Simulate a long process
output$result <- renderText("Process completed!")
})
}
shinyApp(ui, server)
runApp()
library(shiny)
library(googledrive)
ui <- fluidPage(
fileInput("file", "Choose a file to upload"),
actionButton("upload", "Upload to Google Drive"),
verbatimTextOutput("status")
)
server <- function(input, output, session) {
observeEvent(input$upload, {
req(input$file)
# Upload the file to Google Drive
drive_upload(media = input$file$datapath, name = input$file$name)
output$status <- renderText("File uploaded successfully to Google Drive.")
})
}
shinyApp(ui, server)
