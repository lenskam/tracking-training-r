# Install and load the necessary package
install.packages("writexl")
library(writexl)
# List of all variable names (input IDs) from the dashboard
variable_names <- c(
"name", "domain", "subdomain", "location", "level", "type", "training_date",
"reporter_name", "reporter_email", "reporter_function",
"participants_invited", "participants_invited_aps", "participants_invited_experts",
"participants_invited_doctors", "participants_invited_nurses", "participants_invited_acrr",
"participants_invited_lab", "participants_attended", "participants_attended_aps",
"participants_attended_experts", "participants_attended_doctors", "participants_attended_nurses",
"participants_attended_acrr", "participants_attended_lab", "participants_invited_moh",
"participants_invited_asdf", "participants_invited_egpaf", "participants_invited_non_pepfar",
"participants_attended_moh", "participants_attended_asdf", "participants_attended_egpaf",
"participants_attended_non_pepfar", "facilitators_invited", "facilitators_invited_moh",
"facilitators_invited_asdf", "facilitators_invited_egpaf", "facilitators_invited_non_pepfar",
"facilitators_attended", "facilitators_attended_moh", "facilitators_attended_asdf",
"facilitators_attended_egpaf", "facilitators_attended_non_pepfar", "cost_material",
"cost_hall", "cost_food", "cost_lodging", "cost_travel", "cost_transport",
"cost_facilitation", "files"
)
# Create a data frame
df <- data.frame(Variable_Names = variable_names)
# Write to an Excel file
write_xlsx(df, "variable_names.xlsx")
rio::export(df,file = here("www","variables_names.xlsx"))
library(here)
rio::export(df,file = here("www","variables_names.xlsx"))
runApp()
